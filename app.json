{
  "configVersion": "v3",
  "app": {
    "appId": 1120685,
    "appName": "Hass Sync",
    "appType": "app",
    "version": {
      "code": 2,
      "name": "1.3.1"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Sends health data from your Zepp OS watch to Home Assistant via a webhook. Not affiliated with or endorsed by Zepp Health or Home Assistant. Feedback & Support: if you encounter any issues or have suggestions, please contact me at contact@maximebranger.fr."
  },
  "permissions": [
    "device:os.local_storage",
    "device:os.bg_service",
    "device:os.alarm",
    "data:os.device.info",
    "data:user.info",
    "data:user.hd.step",
    "data:user.hd.calorie",
    "data:user.hd.distance",
    "data:user.hd.heart_rate",
    "data:user.hd.sleep",
    "data:user.hd.stress",
    "data:user.hd.spo2",
    "data:user.hd.pai",
    "data:user.hd.workout",
    "data:user.hd.body_temp",
    "data:user.hd.fat_burning",
    "data:user.hd.stand"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-service": {
          "services": [
            "app-service/index"
          ]
        },
        "app-event": {
          "path": "app-service/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Hass Sync"
    },
    "fr-FR": {
      "appName": "Hass Sync"
    },
    "de-DE": {
      "appName": "Hass Sync"
    },
    "es-ES": {
      "appName": "Hass Sync"
    },
    "it-IT": {
      "appName": "Hass Sync"
    },
    "zh-CN": {
      "appName": "Hass Sync"
    }
  },
  "defaultLanguage": "en-US"
}
